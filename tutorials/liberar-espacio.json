{
  "id": "liberar-espacio",
  "version": 1,
  "recordedAt": "2026-09-29T11:28:30.126Z",
  "duration": 43.35,
  "captions": [
    {
      "start": 1.34,
      "end": 5.94,
      "text": "Con los meses, Mini acumula mucha asistencia. Archivá los meses viejos en un archivo, sin perder nada."
    },
    {
      "start": 5.94,
      "end": 9.02,
      "text": "1 · Abrí \"Más\"."
    },
    {
      "start": 9.02,
      "end": 12.03,
      "text": "2 · Entrá a \"Datos\"."
    },
    {
      "start": 12.03,
      "end": 16.09,
      "text": "3 · Primero guardá un \"Respaldo completo\"."
    },
    {
      "start": 16.09,
      "end": 19.69,
      "text": "4 · Tocá \"Archivar meses antiguos\"."
    },
    {
      "start": 19.69,
      "end": 26.63,
      "text": "5 · Elegí cuántos meses mantener en el celular. Recomendado: 3."
    },
    {
      "start": 26.63,
      "end": 32.57,
      "text": "6 · Tocá \"Guardar archivo y archivar\": se descarga un archivo con los meses viejos."
    },
    {
      "start": 32.57,
      "end": 36.95,
      "text": "7 · Con el archivo guardado, confirmá \"Archivar\"."
    },
    {
      "start": 36.95,
      "end": 43.25,
      "text": "¡Listo! Si algún día necesitás esos meses, restaurá el archivo desde \"Datos\"."
    }
  ]
}
