#!/bin/sh
# Before each commit: align package metadata to src/app-version.ts, validate
# the release manifest, then regenerate the Mini build stamp.
# Stages ONLY the version files and the generated files.
set -e
node scripts/sync-app-version.mjs
node scripts/release-manifest.cjs
node scripts/stamp-build.mjs
git add package.json package-lock.json build-info.js sw.js
git add app-release.json
node scripts/release-manifest.cjs --check --staged --release
